# Every environment variable the project uses. Copy to web/.env.local for
# local development. Never commit real values.

# --- Web app: public (sent to the browser) ----------------------------------
# Site name shown everywhere. "Ballboy Sabi" if unset; "Ballboy Predicts" also works.
NEXT_PUBLIC_SITE_NAME=Ballboy Sabi
# Contact email shown on the About page. Leave empty until you have one.
NEXT_PUBLIC_CONTACT_EMAIL=
# Full public URL of the site, used for links in emails and share images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase project URL (Project Settings > API), e.g. https://abc.supabase.co, without /rest/v1.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon (public) key. Safe in the browser because RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Web app: server only (never prefix with NEXT_PUBLIC_) -------------------
# Supabase service role key. Bypasses RLS: server-side code only.
SUPABASE_SERVICE_ROLE_KEY=
# GitHub fine-grained token for this repo only, with Contents: read and write (repository_dispatch
# when a result is saved) and Actions: read and write ("Run now"). Server only (Stage 6).
GITHUB_DISPATCH_TOKEN=
# The repository that holds the model workflow, as owner/name (Stage 6).
GITHUB_REPOSITORY=
# Shared secret the model workflow sends to /api/revalidate after a run (Stage 3).
REVALIDATE_SECRET=
# Secret Vercel Cron sends as a Bearer token to the cron endpoints (Stages 7 and 8).
CRON_SECRET=
# Brevo API key for the weekly Matchday Preview email (Stage 7).
BREVO_API_KEY=
# Sender address for the preview email; must be verified in Brevo (Stage 7).
EMAIL_FROM_ADDRESS=
# Sender name shown in mail apps (Stage 7).
EMAIL_FROM_NAME=That Naija Ballboy
# Most preview emails sent per day, leaving room for auth emails within Brevo's 300 (Stage 7).
EMAIL_DAILY_LIMIT=280
# Secret used to sign one-click unsubscribe links (Stage 7).
UNSUBSCRIBE_SECRET=

# --- GitHub Actions secrets (set in the repo settings, not in .env files) ----
# SUPABASE_URL               Same value as NEXT_PUBLIC_SUPABASE_URL (also read by the seed script).
# SUPABASE_SERVICE_ROLE_KEY  Same value as above; lets the model job write predictions.
# REVALIDATE_URL             The site's /api/revalidate URL, called when a run finishes.
# REVALIDATE_SECRET          Same value as above.
